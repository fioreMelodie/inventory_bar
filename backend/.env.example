# Configuración de entorno - Bar Inventory APP
# Copiar como .env y ajustar los valores

SECRET_KEY=cambiar-esta-clave-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos: mysql | sqlite
DB_ENGINE=sqlite
DB_NAME=bar_inventory
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Origen del frontend (CORS)
FRONTEND_URL=http://localhost:5173
